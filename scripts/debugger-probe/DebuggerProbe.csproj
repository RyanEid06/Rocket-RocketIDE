<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RocketIDE.Debugger">
      <HintPath>$(Payload)/RocketIDE.Debugger.dll</HintPath>
    </Reference>
    <Content Include="$(Payload)/**/*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="UseReleasedRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(Payload)/RocketIDE.runtimeconfig.json" DestinationFiles="$(TargetDir)DebuggerProbe.runtimeconfig.json" />
    <Copy SourceFiles="$(Payload)/RocketIDE.deps.json" DestinationFiles="$(TargetDir)DebuggerProbe.deps.json" />
  </Target>
</Project>
